// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskState {
  TO_DO
  IN_PROGRESS
  DONE
  CANCELLED
  BLOCKED
}

enum TaskPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

model Task {
  id          Int           @id @default(autoincrement())
  name        String        @default("")
  description String        @default("")
  state       TaskState     @default(TO_DO)
  priority    TaskPriority  @default(LOWEST)
  list_id     Int
  list        List          @relation(fields: [list_id], references: [id])
  createdAt   DateTime      @default(now())
}

model List {
  id        Int    @id @default(autoincrement())
  name      String
  tasks     Task[]
  createdAt DateTime @default(now())
}